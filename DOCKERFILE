# PyTorchのCUDA 12.1対応ランタイムイメージを使用
FROM pytorch/pytorch:2.1.0-cuda12.1-cudnn8-runtime

# 作業ディレクトリの設定
WORKDIR /app

# OpenCVの動作に必要なシステムライブラリをインストール
# libgl1-mesa-glx: OpenGL用
# libglib2.0-0: GLib用
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# 依存関係ファイルのコピーとインストール
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ソースコードのコピー
COPY . .

# コンテナ起動時のコマンド
CMD ["python", "main.py"]